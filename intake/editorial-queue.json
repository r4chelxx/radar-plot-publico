KKRGtVPjUnA&_nc_ss=7c689&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQSZpX5vUXR1Wj25TrLvLsPal_cq09zt5K9yYK4NPhyLAw&oe=6AFD4556\",\"media_type\":8,\"product_type\":\"carousel_container\",\"user\":{\"pk\":\"1700440949\",\"username\":\"poynter_institute\",\"id\":\"17841400748496569\"},\"carousel_media_count\":3,\"id\":\"POLARIS_3828917590341915656\"}},{\"node\":{\"__typename\":\"XIGPolarisCarouselMedia\",\"pk\":\"4029553730437711934\",\"__isXIGPolarisMedia\":\"XIGPolarisCarouselMedia\",\"accessibility_caption\":\"Photo by Poynter on November 13, 2026. May be an image of text.\",\"caption\":{\"text\":\"besties, drop your questions for scott pelley!!!! \\ud83e\\udd21\"},\"code\":\"Dfr2cSyFwg-\",\"seo_canonical_url\":null,\"display_uri\":\"https:\\/\\/scontent-iad3-1.cdninstagram.com\\/v\\/t51.82787-15\\/900859397_18657720328024950_777994143938303175_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=ssjSPc4TGq4Q7kNvwEUs3Rd&_nc_oc=Adq8pEMh4Hppgp6nwpztaYRNIJ8SSDWSBzlf8gIQO4yayhdzEbf5ohq0BmqSXLF7RD4&_nc_zt=23&_nc_ht=scontent-iad3-1.cdninstagram.com&_nc_gid=SRDufwRC_I5KKRGtVPjUnA&_nc_ss=7c689&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQSt9ozg2DZkzk5z5Ivxdz55kTMQNk2s6ajCnzknUZ7uqA&oe=6AFD1384\",\"media_type\":8,\"product_type\":\"carousel_container\",\"user\":{\"pk\":\"1700440949\",\"username\":\"poynter_institute\",\"id\":\"17841400748496569\"},\"carousel_media_count\":8,\"id\":\"POLARIS_4029553730437711934\"}},{\"node\":{\"__typename\":\"XIGPolarisCarouselMedia\",\"pk\":\"4026792958226020354\",\"__isXIGPolarisMedia\":\"XIGPolarisCarouselMedia\",\"accessibility_caption\":\"Photo by Poynter on November 09, 2026. May be an image of text.\",\"caption\":{\"text\":\"CNN\\u2019s John King may be known by millions of Americans for his work in front of the Magic Wall on election night, but he says the most important part of his election coverage happens far from the television studio \\u2014 out on the road, sitting at kitchen tables with voters and hearing firsthand what they think.\\n\\nOn this special episode of \\u201cThe Poynter Report Podcast,\\u201d King joins host Tom Jones to break down the sweeping results of the 2026 midterm elections, what went wrong for Republicans, what he learned from talking with voters, and what the Democratic victories could mean for the next two years of Donald Trump\\u2019s presidency.\\n\\n\\ud83d\\udd17Link in our bio to watch the full episode on YouTube.\"},\"code\":\"DfiCtxTGzgC\",\"seo_canonical_url\":null,\"display_uri\":\"https:\\/\\/scontent-iad6-1.cdninstagram.com\\/v\\/t51.82787-15\\/882224085_18656336413024950_1618434799478269122_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=nmwwrtCSB8cQ7kNvwG1qr9f&_nc_oc=AdpiD0oj5ASj8vAJw6UT8Ow6WrU8LPjgX7qZlvHOaRP5EIh93-bOX1iuRAvwVSazFSI&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=SRDufwRC_I5KKRGtVPjUnA&_nc_ss=7c689&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQTT_z2rehxkGm75aKqb3dxGYzsdD-JPFo4F8JFKYjcCTw&oe=6AFD39D6\",\"media_type\":8,\"product_type\":\"carousel_container\",\"user\":{\"pk\":\"1700440949\",\"username\":\"poynter_institute\",\"id\":\"17841400748496569\"},\"carousel_media_count\":4,\"id\":\"POLARIS_4026792958226020354\"}},{\"node\":{\"__typename\":\"XIGPolarisVideoMedia\",\"pk\":\"4026762759873974974\",\"__isXIGPolarisMedia\":\"XIGPolarisVideoMedia\",\"accessibility_caption\":\"Video by PolitiFact on November 09, 2026. May be a Twitter screenshot of text.\",\"caption\":{\"text\":\"In his Nov. 8 \\u201c60 Minutes\\u201d interview, President Donald Trump credited his net worth growth to the stock market. That\\u2019s not what his financial disclosures show. Most of his gains came from non-stock sources, such as cryptocurrency and licensing agreements. #Trump #60minutes #wealth #crypto #stocks\"},\"code\":\"Dfh72U5D1K-\",\"seo_canonical_url\":null,\"display_uri\":\"https:\\/\\/scontent-iad3-1.cdninstagram.com\\/v\\/t51.71878-15\\/891099646_1700117041820692_7578636574678608942_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ\\u00253D\\u00253D&_nc_ohc=v5AlsPY0KOQQ7kNvwGxa2ej&_nc_oc=AdoY_Ec0dtAlTOCQN6oGoWHAuUs8l2D40r91OaJJJWAcekEI5PVvG7nuf53-27XM3FU&_nc_zt=23&_nc_ht=scontent-iad3-1.cdninstagram.com&_nc_gid=SRDufwRC_I5KKRGtVPjUnA&_nc_ss=7c689&_nc_ct=RQosPBUKFQgAAAA&oh=00_AQS-FT9Y5w-4C-5n3OlS4G_t9A-tRQfzjHq9NK7F1ZFcCg&oe=6AFD1EAC\",\"media_type\":2,\"product_type\":\"clips\",\"user\":{\"pk\":\"5378803501\",\"username\":\"politifact\",\"id\":\"17841405385042350\"},\"id\":\"POLARIS_4026762759873974974\"}},{\"node\":{\"__typename\":\"XIGPolarisCarouselMedia\",\"pk\":\"4024489506816239622\",\"__isXIGPolarisMedia\":\"XIGPolarisCarouselMedia\",\"accessibility_caption\":\"Photo by Poynter on November 06, 2026. May be an image of text.\",\"caption\":{\"text\":\"the lion does not concern himself with four day old election night newsroom pizza \\ud83e\\udd21\"},\"code\":\"DfZ2-JAEagG\",\"seo_canonical_url\":null,\"display_uri\":\"https:\\/\\/scontent-iad3-2.cdninstagram.com\\/v\\/t51.82787-15\\/885832351_18655217011024950_5444445974516660273_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=QOUhHRr3RTkQ7kNvwFizMsT&_nc_oc=AdrTvQDOEtJtSO8LUJNuN-1Pmh4cQQzqrAYoG9mp5QmlKDxk6A7WY3jSEKx6yyP5N34&_nc_zt=23&_nc_ht=scontent-iad3-2.cdninstagram.com&_nc_gid=SRDufwRC_I5KKRGtVPjUnA&_nc_ss=7c689&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQSLV2rYg3X60DnaaEVdQTpQ9l1mh9ADwpLMHhGGh70EFQ&oe=6AFD2347\",\"media_type\":8,\"product_type\":\"carousel_container\",\"user\":{\"pk\":\"1700440949\",\"username\":\"poynter_institute\",\"id\":\"17841400748496569\"},\"carousel_media_count\":12,\"id\":\"POLARIS_4024489506816239622\"}},{\"node\":{\"__typename\":\"XIGPolarisVideoMedia\",\"pk\":\"4023913653254607679\",\"__isXIGPolarisMedia\":\"XIGPolarisVideoMedia\",\"accessibility_caption\":\"Video by Poynter on November 05, 2026. May be an image of magazine and text.\",\"caption\":{\"text\":\"The dust is settling on the 2026 midterm elections, but one question remains: Can we now trust the polls? Poynter\\u2019s senior media writer Tom Jones explains why many voters were skeptical of the polls ahead of Election Day and what this moment could mean for polls leading up to the 2028 presidential election. \\n\\n\\ud83d\\udd17Link in our bio to subscribe to The Poynter Report newsletter for more #media news, industry updates and commentary.\"},\"code\":\"DfX0CXlFdM_\",\"seo_canonical_url\":null,\"display_uri\":\"https:\\/\\/scontent-iad6-1.cdninstagram.com\\/v\\/t51.71878-15\\/887051423_1793751385178795_6812473538632591662_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ\\u00253D\\u00253D&_nc_ohc=W7xqTSo1wgcQ7kNvwE-ZfG6&_nc_oc=AdqSN8E6EWVFR6D1_XFkcK738xpE1QHytpxlh2d5eYVoWlE218A4Toesdd_uWA-TYQU&_nc_zt=23&_nc_ht=scontent-iad6-1.cdninstagram.com&_nc_gid=SRDufwRC_I5KKRGtVPjUnA&_nc_ss=7c689&_nc_ct=RQosPBUKFQQAAAA&oh=00_AQS_7ttIswj0nkCEJqgYGMcunGHJhDZ5eMDDwikbW3pBMQ&oe=6AFD2DBF\",\"media_type\":2,\"product_type\":\"clips\",\"user\":{\"pk\":\"1700440949\",\"username\":\"poynter_institute\",\"id\":\"17841400748496569\"},\"id\":\"POLARIS_4023913653254607679\"}},{\"node\":{\"__typename\":\"XIGPolarisCarouselMedia\",\"pk\":\"4023143830605644973\",\"__isXIGPolarisMedia\":\"XIGPolarisCarouselMedia\",\"accessibility_caption\":\"Photo by Poynter on November 04, 2026. May be an image of text.\",\"caption\":{\"text\":\"There\\u2019s one word that can sum up the media\\u2019s reaction to Tuesday\\u2019s historic midterm elections: Wow. \\n\\nOn Tuesday night, as one of the most pivotal midterm elections played out, the word \\u201cwow\\u201d might have been uttered on TV more than any other interjection ever, writes senior media writer Tom Jones. \\n\\n\\u201cAnchors, analysts, election experts \\u2014 you name it \\u2014 all ran out of words to express their surprise at a variety of races,\\u201d Jones wrote. \\u201cBut who could blame them on a night full of surprises as a blue wave crashed over the country and Democrats took control of the Senate and House of Representatives?\\u201d\\n\\n\\ud83d\\udd17Link in our bio to read more 2026 midterm election coverage.\"},\"code\":\"DfVE_-XjcSt\",\"seo_canonical_url\":null,\"display_uri\":\"https:\\/\\/scontent-iad3-2.cdninstagram.com\\/v\\/t51.82787-15\\/888176888_18654532747024950_2026318540911505767_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=U8_tZk7GnuMQ7kNvwGGVwcP&_nc_oc=Adri77y53m0s2-tJvsH8P2sqrSPmvnXOR0mUjAfb4sHmMLPE8aFbJJMPYMkBuNrKNy4&_nc_zt=23&_nc_ht=scontent-iad3-2.cdninstagram.com&_nc_gid=SRDufwRC_I5KKRGtVPjUnA&_nc_ss=7c689&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQS-pgUaGYytDMXTVwZKUK_WgzspiB7pMOUg9XcdZkIHeA&oe=6AFD1C9F\",\"media_type\":8,\"product_type\":\"carousel_container\",\"user\":{\"pk\":\"1700440949\",\"username\":\"poynter_institute\",\"id\":\"17841400748496569\"},\"carousel_media_count\":2,\"id\":\"POLARIS_4023143830605644973\"}},{\"node\":{\"__typename\":\"XIGPolarisCarouselMedia\",\"pk\":\"4022401310712654411\",\"__isXIGPolarisMedia\":\"XIGPolarisCarouselMedia\",\"accessibility_caption\":\"Photo by Poynter on November 03, 2026. May be an image of text.\",\"caption\":{\"text\":\"Across the country, from covering campaign rallies to creating voter guides, student journalists have kicked into high gear to take on the consequential 2026 midterm elections, despite their relative inexperience covering politics and young voters being notoriously absent at the polls.\\n\\nAt Ohio University\\u2019s The Post, students have published explainers on state issues and a voting guide. The Duke Chronicle led a collaboration between student newspapers across North Carolina in addition to publishing about two dozen election-related articles.\\n \\nVisit the link in our bio to read more about how student journalists are covering the #2026midterms, originally published by the Student Press Report. \\ud83d\\uddde\\ufe0f\"},\"code\":\"DfScK41F-pL\",\"seo_canonical_url\":null,\"display_uri\":\"https:\\/\\/scontent-iad3-1.cdninstagram.com\\/v\\/t51.82787-15\\/885389086_18654173389024950_4500977160350869183_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=fHsnLmc8qWEQ7kNvwF1Ibzp&_nc_oc=AdpfA79pdMqqOPjAosOvbp05FjvFbQdTwUNMGqo3nWcz5MJiGjDdgh2zMnrduG1i5sk&_nc_zt=23&_nc_ht=scontent-iad3-1.cdninstagram.com&_nc_gid=SRDufwRC_I5KKRGtVPjUnA&_nc_ss=7c689&_nc_ct=RQosPBUKFQIAAAA&oh=00_AQQ4HlWKbGGflQ1zIPC73CIaJKxwJE_9KJ0zPnS0cHTCPQ&oe=6AFD1376\",\"media_type\":8,\"product_type\":\"carousel_container\",\"user\":{\"pk\":\"1700440949\",\"username\":\"poynter_institute\",\"id\":\"17841400748496569\"},\"carousel_media_count\":3,\"id\":\"POLARIS_4022401310712654411\"}},{\"node\":{\"__typename\":\"XIGPolarisVideoMedia\",\"pk\":\"4022272081948925857\",\"__isXIGPolarisMedia\":\"XIGPolarisVideoMedia\",\"accessibility_caption\":\"Video by PolitiFact on November 03, 2026. May be an image of one or more people and text.\",\"caption\":{\"text\":\"It's Election Day! \\ud83d\\uddf3\\ufe0f\\n\\nTonight, after months of attack ads, mailers and annoying text messages, we\\u2019ll finally know most of the 2026 midterm election winners. But if we get to the end of election night and a race still hasn\\u2019t been called, that\\u2019s not a sign of fraud. Here's why.\\n\\n#electionday #midterms #electionresults #voting\"},\"code\":\"DfR-yXKiV-h\",\"seo_canonical_url\":null,\"display_uri\":\"https:\\/\\/scontent-iad3-1.cdninstagram.com\\/v\\/t51.71878-15\\/885931503_1007616525716359_4268075391296333039_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ\\u00253D\\u00253D&_nc_ohc=GqiISlCqbbQQ7kNvwGiGHBv&_nc_oc=AdrReminbBRc2IxbIlfOtCJvDOusadXPLIAeXM-B84AW0Q_yDSGn3OgKxSYTAMn15ls&_nc_zt=23&_nc_ht=scontent-iad3-1.cdninstagram.com&_nc_gid=SRDufwRC_I5KKRGtVPjUnA&_nc_ss=7c689&_nc_ct=RQosPBUKFQQAAAA&oh=00_AQToD3A2na-iXUNnIMptpIAAwmvJurEaz9gUVdPWN_cEqA&oe=6AFD2CD1\",\"media_type\":2,\"product_type\":\"clips\",\"user\":{\"pk\":\"5378803501\",\"username\":\"politifact\",\"id\":\"17841405385042350\"},\"id\":\"POLARIS_4022272081948925857\"}},{\"node\":{\"__typename\":\"XIGPolarisCarouselMedia\",\"pk\":\"4021822989390050544\",\"__isXIGPolarisMedia\":\"XIGPolarisCarouselMedia\",\"accessibility_caption\":\"Photo by PolitiFact on November 02, 2026. May be an image of text.\",\"caption\":{\"text\":\"Tomorrow is Election Day for the 2026 midterms. As you wait for the polls to open and results to come in, brush up on some common voting falsehoods that PolitiFact sees every election cycle. \\n\\nPolitiFact\\u2019s entire team will be working hard tomorrow to bring you the latest facts on voting, candidate rhetoric, results and more through our live blog. If you see something election-related you think we should fact-check, tag us in the comments or send us the link at truthometer\\u0040politifact.com. \\n\\n#election #midterms #voting #factcheck #2026elections\"},\"code\":\"DfQYrNIF_Tw\",\"seo_canonical_url\":null,\"display_uri\":\"https:\\/\\/scontent-iad3-1.cdninstagram.com\\/v\\/t51.82787-15\\/883300258_18444316666179502_1145892784914012236_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=YwamRGLPKgYQ7kNvwG89vhS&_nc_oc=AdoJiS8SksMFelObRuuqe6RUnS