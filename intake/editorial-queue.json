      "id": "fddd4b182df3b66567567f94336c919bf6954a3c89e9cff41cbf16c679a2d37e",
      "title": "Spencer Fellowship for Education Reporting 2027 (Funded)",
      "url": "https://opportunitydesk.org/2026/11/06/spencer-fellowship-for-education-reporting-2027",
      "category": "opportunities",
      "providers": [
