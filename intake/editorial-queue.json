      "id": "d24ca25657028d534bb92ccd25b39d0877bf7b1844e62ba075365025dc11dc7e",
      "title": "Morgridge Acceleration Program (MAP) Fellowship 2027 (Funded)",
      "url": "https://opportunitydesk.org/2026/11/09/morgridge-acceleration-program-fellowship-2027",
      "category": "opportunities",
