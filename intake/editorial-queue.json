      "id": "fd84e850b51d43d439eea917135e10b90b79fedd62c5f808a56248c50fb77c50",
      "title": "saajp investigative journalism grants southern africa accountability journalism project",
      "url": "https://gfmd.info/fundings/saajp-investigative-journalism-grants-southern-africa-accountability-journalism-project",
      "category": "opportunities",
