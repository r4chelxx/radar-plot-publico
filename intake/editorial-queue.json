      "id": "6d49155eca3efdabd2d3681c83e054317a8b6a5956de2a27b97c38c85f01045e",
      "title": "Snowflake Geospatial",
      "url": "https://www.snowflake.com/en/developers/guides/getting-started-with-geospatial-geography",
      "category": "tools",
