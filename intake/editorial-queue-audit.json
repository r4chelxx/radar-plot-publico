      "id": "081736687e6cb468450677ea6ea73b3882a2bf6b635f710b0ce83f975d8fa726",
      "title": "CNN’s John King has seen a lot of elections. This one was different.",
      "url": "https://mailchi.mp/poynter/cnns-john-king-has-seen-a-lot-of-elections-this-one-was-different",
      "category": "uncategorized",
      "checkedAt": "2026-11-10T22:02:51.489Z",
      "httpStatus": 200,
      "finalUrl": "https://mailchi.mp/poynter/cnns-john-king-has-seen-a-lot-of-elections-this-one-was-different",
      "contentType": "text/html; charset=UTF-8",
      "pageTitle": "Poynter",
