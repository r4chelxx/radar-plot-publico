      "id": "43bde5026c08ea4aeda79bbb8fb14d7a3838ba520686ca4e6097db527538884a",
      "title": "🔥 'Exército do Lula’ contra as bets",
      "url": "https://substack.com/redirect/5c67eb1f-f095-44f6-b3ca-138fac922679",
      "category": "uncategorized",
      "checkedAt": "2026-11-16T19:21:28.847Z",
