      "id": "b7e14e78a9fce3908b8bbc1b46d37c865f866d77e0b9f935b43f0a06fada9d0b",
      "title": "Misread Mandate",
      "url": "https://www.salon.com/2026/11/05/goodbye-from-salon",
      "category": "uncategorized",
