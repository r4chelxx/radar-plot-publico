      "id": "63cea94d2793d5495899796463d2326bccceed323bb9ebbff2f0c8c9b465cf97",
      "title": "How ordinary people build solutions",
      "url": "https://us.list-manage.com/c5az_fCnvaM",
      "category": "uncategorized",
      "checkedAt": "2026-11-10T20:44:59.460Z",
