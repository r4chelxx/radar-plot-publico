      "title": "Misread Mandate",
      "url": "https://www.status.news/p/60-minutes-bari-weiss-nick-bilton-gianna-toboni-immigration-story",
      "category": "uncategorized",
      "checkedAt": "2026-11-18T07:07:48.587Z",
