      "id": "8f93f35be40c25e0034155a81b1481e2f743b111f6c4b37352660c63dd55d87c",
      "title": "Haley Stevens’ stunning endorsement set off a media firestorm. Will Michigan voters care?",
      "url": "https://x.com/mehdirhasan/status/2116959181412630940",
      "category": "uncategorized",
      "checkedAt": "2026-11-10T20:50:45.379Z",
      "httpStatus": 200,
      "finalUrl": "https://x.com/mehdirhasan/status/2116959181412630940",
      "contentType": "text/html; charset=UTF-8",
