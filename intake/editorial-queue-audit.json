      "title": "🔥 'Exército do Lula’ contra as bets",
      "url": "https://substack.com/redirect/b5df197b-c602-40f2-a3df-435353625e38",
      "category": "uncategorized",
      "checkedAt": "2026-11-16T19:27:34.535Z",
