      "id": "8408660585cf316ff7d91c0dfafd0c93a6bdf625d94f1bec3e847afac6891002",
      "title": "African Wildlife Foundation (AWF) Geospatial Leaders Fellowship 2027",
      "url": "https://opportunitydesk.org/2026/11/11/awf-geospatial-leaders-fellowship-2027",
      "category": "opportunities",
      "checkedAt": "2026-11-11T18:42:47.988Z",
