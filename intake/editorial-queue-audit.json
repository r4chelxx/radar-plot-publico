      "id": "38c2ac25d007834167c71855c5fddd2e5a36fade6dfeae1c6226304e5be48d7e",
      "title": "How ordinary people build solutions",
      "url": "https://us.list-manage.com/MUPd6Q_ns0S",
      "category": "uncategorized",
      "checkedAt": "2026-11-27T23:44:07.796Z",
