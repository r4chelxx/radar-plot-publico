      "title": "Asia House Fellowship 2027/2028 (£24,000 stipend)",
      "url": "https://opportunitydesk.org/2026/11/21/asia-house-fellowship-2027-2028",
      "category": "opportunities",
      "checkedAt": "2026-11-27T23:44:07.796Z",
