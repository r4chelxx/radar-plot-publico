      "id": "5c85efb00ef5956c46512421d1ade336c7d86b4cfe02859d09288a59e56e2c02",
      "title": "🔥O SUS e a ‘doutrinação’ do Enem",
      "url": "https://substack.com/redirect/5c302680-1698-42d5-ac3f-5e6239896ee9",
      "category": "uncategorized",
      "checkedAt": "2026-11-16T19:21:28.847Z",
      "httpStatus": 200,
      "finalUrl": "https://www.agencialupa.org/politica-de-privacidade/?utm_source=substack&utm_medium=email",
