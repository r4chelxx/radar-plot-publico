      "id": "b5b5d5a1b82f5334a24387c660f31f277014bbd6c8699466cabae1343e1cc86d",
      "title": "International Blue Carbon Institute (IBCI) Fellowship Program 2027 ($60,000 grant)",
      "url": "https://opportunitydesk.org/2026/11/06/ibci-fellowship-program-2027",
      "category": "opportunities",
      "checkedAt": "2026-11-10T20:36:10.810Z",
