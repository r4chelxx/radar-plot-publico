      "id": "7ac83046fffab314e6c51b33d3269664f4163cbed634583d707a28087cccceef",
      "title": "It’s been a great year for investigative reporting. But there’s a catch.",
      "url": "https://www.poynter.org/press-freedom-watch",
      "category": "uncategorized",
      "checkedAt": "2026-11-13T18:31:33.655Z",
      "httpStatus": 200,
      "finalUrl": "https://www.poynter.org/press-freedom-watch/",
      "contentType": "text/html; charset=UTF-8",
