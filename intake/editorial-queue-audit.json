      "id": "dd1dfb3cb86c0457315bb0ba377fc75d5bb9a1a12d36e677f14fc04ec965d891",
      "title": "Part 2: Let the Data Breathe",
      "url": "https://pudding.cool/process/how-to-make-dope-shit-part-2",
      "category": "tools",
      "checkedAt": "2026-11-28T02:04:02.096Z",
