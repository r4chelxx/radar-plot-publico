      "id": "76117839ae52940fd1b49abb3986e3cbdc151386a85cc6910b2e13692b544795",
      "title": "Dataphyte Foundation Infra-Watch Media Fellowship 2027",
      "url": "https://opportunitydesk.org/2026/11/21/dataphyte-foundation-infra-watch-media-fellowship-2027",
      "category": "opportunities",
      "checkedAt": "2026-11-27T23:44:07.796Z",
