      "id": "9a5441c2d078c91701f6ea05bbb218b6d5af8e1b679e52e577a3e0900ab11c39",
      "title": "🔥 'Exército do Lula’ contra as bets",
      "url": "https://substack.com/redirect/c1b08dbd-e9f5-466e-aa8b-80b6020d9785",
      "category": "uncategorized",
      "checkedAt": "2026-11-16T19:21:28.847Z",
