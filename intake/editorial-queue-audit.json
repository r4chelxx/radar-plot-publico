      "id": "1e85c5f6259cc865ff9d77cdbac59a3177e116e88f35957b111d73fd29611112",
      "title": "Laurels and Darts",
      "url": "https://www.cjr.org/the_profile/nyt-pitchbot.php",
      "category": "uncategorized",
      "checkedAt": "2026-11-10T20:36:10.810Z",
      "httpStatus": 200,
