      "id": "7aa79e02bf50f69bfb41d152f9affbbb99c0894cf3ee264357ca21d4fad203b9",
      "title": "O fim do inquérito das fake news e uma mineradora na região de Abrolhos",
      "url": "https://substack.com/redirect/d9987b5f-fdbb-40e6-8546-83fda2b0de1f",
      "category": "uncategorized",
      "checkedAt": "2026-11-16T19:27:34.535Z",
