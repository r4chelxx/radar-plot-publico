      "title": "Morgan Stanley Sustainable Finance Fellowship Program 2027 (Paid)",
      "url": "https://opportunitydesk.org/2026/10/30/morgan-stanley-sustainable-finance-fellowship-program-2027",
      "category": "opportunities",
      "checkedAt": "2026-11-10T20:31:28.952Z",
