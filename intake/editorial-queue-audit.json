      "id": "c754fc517be9b42bc350762071d680ff3591dad42f303fd50918c1ed108d3c27",
      "title": "681: quantum of sollazzo",
      "url": "https://usafacts.org/answers/how-much-are-candidates-spending-for-the-midterm/country/united-states",
      "category": "uncategorized",
      "checkedAt": "2026-11-16T16:53:40.266Z",
      "httpStatus": 200,
