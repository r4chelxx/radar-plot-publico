      "id": "c55bad255efd95eece07037332a1f75a4fae71897c41c64c4dc687cdb80fd18b",
      "title": "Atlas Digital de Desastres no Brasil",
      "url": "https://atlasdigital.mdr.gov.br/",
      "category": "datasets",
